.top-bar {
    flex-direction: row;
    background-color: rgb(21, 30, 48);
    padding: 10px;
    height: 80px;
}

.top-bar Label {
    color: rgb(233, 238, 247);
    font-size: 20px;
    margin-right: 20px;
    -unity-text-align: middle-left;
}

#btn-next-turn {
    background-color: rgb(242, 184, 75);
    color: rgb(26, 20, 5);
    font-size: 22px;
    -unity-font-style: bold;
    width: 200px;
    height: 60px;
    margin-left: auto;
}

.page {
    flex-grow: 1;
    background-color: rgb(13, 19, 32);
    padding: 20px;
}